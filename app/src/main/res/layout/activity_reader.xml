<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- WebView: ページロード中のみ表示 (画像URL取得用) -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- RecyclerView: 翻訳済みマンガページ一覧 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#111111"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ページ読み込みプログレスバー -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="@color/accent"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- モデルステータス通知 -->
    <TextView
        android:id="@+id/tvModelStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#CC000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/navBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="4dp" />

    <!-- ナビゲーションバー (タップで表示/非表示) -->
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#DD000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="8dp">

        <!-- 戻るボタン -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="戻る" />

        <!-- エピソードタイトル -->
        <TextView
            android:id="@+id/tvEpisodeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="第1話"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

        <!-- OCRオーバーレイ切り替えボタン -->
        <Button
            android:id="@+id/btnToggleOcr"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="翻訳"
            android:textSize="11sp"
            android:backgroundTint="@color/accent"
            android:textColor="@color/white"
            android:visibility="gone"
            android:layout_marginEnd="4dp"
            android:paddingHorizontal="8dp" />

        <!-- 前の話 -->
        <Button
            android:id="@+id/btnPrevEpisode"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="◀"
            android:textSize="12sp"
            android:backgroundTint="@color/bg_secondary"
            android:textColor="@color/white"
            android:layout_marginEnd="4dp"
            android:paddingHorizontal="4dp" />

        <!-- 次の話 -->
        <Button
            android:id="@+id/btnNextEpisode"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="▶"
            android:textSize="12sp"
            android:backgroundTint="@color/accent"
            android:textColor="@color/white"
            android:paddingHorizontal="4dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
