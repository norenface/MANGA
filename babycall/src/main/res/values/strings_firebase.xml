<?xml version="1.0" encoding="utf-8"?>
<!--
    Firebase configuration for BabyCall.

    Fill these in with values from your own Firebase project (Project
    Settings > General > Your apps > Android app, and Realtime Database).
    See README-babycall.md for the exact steps. Until these are filled in,
    the app runs but pairing/calling will not work.
-->
<resources>
    <string name="firebase_api_key" translatable="false">YOUR_FIREBASE_API_KEY</string>
    <string name="firebase_application_id" translatable="false">YOUR_FIREBASE_APPLICATION_ID</string>
    <string name="firebase_project_id" translatable="false">YOUR_FIREBASE_PROJECT_ID</string>
    <string name="firebase_database_url" translatable="false">https://YOUR_PROJECT-default-rtdb.firebaseio.com</string>
</resources>
