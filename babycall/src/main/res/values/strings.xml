<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">BabyCall</string>

    <!-- Role select -->
    <string name="role_select_subtitle">赤ちゃんが勝手に切ったり、他の人に電話をかけたりできない、安心のビデオ通話アプリです。</string>
    <string name="role_select_join_family_button">通話に参加する(番号を入力)</string>
    <string name="role_select_baby_button">赤ちゃんの端末として設定する</string>

    <!-- Baby setup -->
    <string name="baby_setup_title">赤ちゃん端末の設定</string>
    <string name="baby_setup_subtitle">この端末を赤ちゃん専用にします。名前とPINを入力してください。あとで表示される番号を、通話したいご家族に伝えます。</string>
    <string name="hint_baby_name">呼び名(例:ゆうくん)</string>
    <string name="hint_pin">暗証番号(4〜6桁)</string>
    <string name="hint_pin_confirm">暗証番号(確認)</string>
    <string name="pin_explanation">このPINは赤ちゃん端末で通話を終了したり、設定を解除したりする際に必要です。赤ちゃんには教えないでください。</string>
    <string name="label_transport_mode">接続方式</string>
    <string name="transport_mode_cloud">インターネット(どこからでも呼びかけ可能・アカウント不要)</string>
    <string name="transport_mode_local">ローカル(自宅Wi-Fi内のみ・アカウント不要)</string>
    <string name="warning_permissions_required">通話にはカメラとマイクの権限が必要です。設定から許可してください。</string>
    <string name="button_setup_baby">この端末を設定する</string>
    <string name="error_pairing_wrong_code_attempt">番号が違う端末から接続がありました。番号を再確認してください。</string>
    <string name="button_go_home">ホームへ</string>
    <string name="baby_code_title">この番号をご家族に伝えてください</string>
    <string name="baby_code_instructions">この番号を、通話したいご家族に伝えてください。</string>
    <string name="baby_code_instructions_waiting">同じWi-Fi内で、この番号を伝えたい方に「通話に参加する」から入力してもらってください。入力が完了するまでこの画面を閉じないでください。</string>
    <string name="baby_code_instructions_ready">この番号はずっと使えます。通話したいご家族に伝えてください。相手はBabyCallアプリで「通話に参加する」を選び、この番号を入力するだけで、いつでも赤ちゃんに呼びかけられるようになります。</string>
    <string name="button_copy_code">番号をコピーする</string>
    <string name="toast_code_copied">番号をコピーしました</string>

    <!-- Join a call (any viewer: parent, grandparent, ...) -->
    <string name="join_family_title">通話に参加する</string>
    <string name="join_family_subtitle">赤ちゃん端末に表示された番号を入力してください。以後、この端末からいつでも赤ちゃんに呼びかけられるようになります。</string>
    <string name="hint_your_name">お名前(例:ママ)</string>
    <string name="hint_invite_code">番号</string>
    <string name="button_join">参加する</string>
    <string name="button_invite_family">家族を招待する</string>
    <string name="invite_dialog_title">この番号を伝えたい方にお伝えください</string>
    <string name="invite_dialog_message">%1$s\n\nこの番号はずっと使えます。伝えた方がBabyCallアプリで「通話に参加する」を選び、この番号を入力すると、その方の端末からも赤ちゃんに呼びかけられるようになります。通話中に後から入ることもできます。</string>
    <string name="status_searching_parent">赤ちゃん端末を探しています…</string>
    <string name="error_no_parent_found">赤ちゃん端末が見つかりませんでした。同じWi-Fiに接続し、赤ちゃん端末側の画面が開いているか確認してください。</string>
    <string name="pick_parent_title">どの端末に接続しますか?</string>

    <!-- Errors -->
    <string name="error_pin_format">PINは4〜6桁の数字で入力してください。</string>
    <string name="error_pin_mismatch">PINが一致しません。</string>
    <string name="error_pin_incorrect">PINが違います。</string>
    <string name="error_code_format">正しい番号を入力してください。</string>
    <string name="error_generic">エラーが発生しました。もう一度お試しください。</string>
    <string name="error_pairing_timeout">応答がありませんでした。番号が正しいか確認してください。</string>
    <string name="error_join_family_unreachable">赤ちゃん端末に接続できませんでした。赤ちゃん端末の電源が入っていて、インターネットに接続されているか確認してください。</string>

    <!-- Call screen -->
    <string name="call_connecting">つながるまで、少々お待ちください…</string>
    <string name="viewer_count_format">%1$d人が視聴中</string>
    <string name="button_mute">ミュート</string>
    <string name="button_end_call">通話を終了</string>
    <string name="button_switch_camera">カメラ切替</string>
    <string name="button_answer">でんわにでる</string>
    <string name="pin_dialog_end_call_title">通話を終了しますか?</string>

    <!-- Baby home -->
    <string name="baby_home_waiting_emoji">🧸</string>
    <string name="baby_home_waiting_message">呼ばれるのを待っているよ</string>
    <string name="baby_home_exit_hint_title">設定の開き方</string>
    <string name="baby_home_exit_hint_message">遊べるアプリの変更や設定解除をしたいときは、画面の左下すみを3秒間長押しして、設定したPINを入力してください(赤ちゃんが偶然見つけないよう、見た目には何も表示されません)。</string>
    <string name="pin_dialog_unpair_title">PINを入力してください</string>
    <string name="caregiver_menu_title">何をしますか?</string>
    <string name="caregiver_menu_view_code">家族に伝える番号を確認する</string>
    <string name="caregiver_menu_manage_apps">遊べるアプリを選ぶ</string>
    <string name="caregiver_menu_screen_share">画面共有を設定する</string>
    <string name="caregiver_menu_unpair">この端末の設定を解除する</string>

    <!-- App picker (baby device: choose apps the baby can open) -->
    <string name="app_picker_title">遊べるアプリを選ぶ</string>
    <string name="app_picker_subtitle">選んだアプリのアイコンが、赤ちゃんの待機画面に表示されます。タップすると起動します。</string>
    <string name="button_save_apps">保存する</string>
    <string name="button_manage_apps">遊べるアプリを選ぶ</string>

    <!-- Screen share setup (baby device: enable game-screen sharing + video bubble) -->
    <string name="button_screen_share_setup">オンライン共有を設定する(任意)</string>
    <string name="screen_share_setup_title">オンライン共有の設定</string>
    <string name="screen_share_setup_explanation">この設定をすると、ご家族がオンラインで参加したときに、赤ちゃんの様子と遊んでいる画面を見られるようになります。赤ちゃんの画面には小さなビデオ通話が表示されるだけで、操作の邪魔にはなりません。どちらも、この端末で一度だけ手動で許可が必要です(端末を再起動すると、もう一度許可が必要になることがあります)。</string>
    <string name="screen_share_step1_title">手順1: 他のアプリの上に表示を許可</string>
    <string name="screen_share_step1_button">許可する</string>
    <string name="screen_share_step2_title">手順2: 画面の共有を許可</string>
    <string name="screen_share_step2_button">許可する</string>
    <string name="screen_share_status_granted">許可済みです</string>
    <string name="screen_share_status_not_granted">まだ許可されていません</string>

    <!-- Parent home -->
    <string name="button_call_baby">呼びかける</string>
    <string name="baby_connected">赤ちゃん端末とつながっています</string>
    <string name="baby_not_connected">赤ちゃん端末が未接続です。下のボタンで番号を発行してください。</string>
    <string name="baby_not_connected_local">赤ちゃん端末が未接続です。最初のセットアップをやり直してペアリングしてください。</string>
    <string name="button_generate_pairing_code">ペアリング番号を発行する</string>
    <string name="online_status_ready">外出先からの通話: 対応(自宅Wi-Fiで前回確認済み)</string>
    <string name="online_status_unknown">外出先からの通話: 未確認(赤ちゃん端末と同じWi-Fiで一度呼びかけると確認されます)</string>
    <string name="content_desc_settings">設定</string>

    <!-- Settings -->
    <string name="settings_title">設定</string>
    <string name="settings_auto_answer">自動応答をオンにする</string>
    <string name="settings_auto_answer_explanation">オンの場合、赤ちゃん端末は着信すると操作なしで自動的につながります(推奨)。オフの場合は赤ちゃん端末に応答ボタンが表示されます。</string>
    <string name="settings_change_pin">PINの変更</string>
    <string name="settings_pin_explanation">赤ちゃん端末で通話終了・設定解除に使うPINです。変更すると両方の端末に反映されます。</string>
    <string name="hint_new_pin">新しいPIN</string>
    <string name="hint_new_pin_confirm">新しいPIN(確認)</string>
    <string name="button_save_pin">PINを保存</string>
    <string name="settings_pin_saved">PINを更新しました。</string>
    <string name="error_local_baby_unreachable">赤ちゃん端末が見つかりません。同じWi-Fiに接続されているか確認してから、もう一度お試しください。</string>
    <string name="error_local_unpair_not_delivered">赤ちゃん端末に解除を伝えられませんでした(この保護者端末側の接続情報は解除しました)。赤ちゃん端末が同じWi-Fiに繋がったら、もう一度この操作をお試しください。</string>
    <string name="button_unpair_baby">赤ちゃん端末の接続を解除する</string>
    <string name="unpair_baby_confirm_title">接続を解除しますか?</string>
    <string name="unpair_baby_confirm_message">赤ちゃん端末との接続を解除します。再度使うには新しいペアリング番号での接続が必要です。</string>

    <!-- Notification -->
    <string name="notification_channel_baby_listener">着信待機</string>
    <string name="notification_listener_title">BabyCall 待機中</string>
    <string name="notification_listener_text">保護者からの通話をお待ちしています</string>

    <!-- Shared dialogs -->
    <string name="button_confirm">決定</string>
    <string name="button_cancel">キャンセル</string>
    <string name="button_close">閉じる</string>
</resources>
