<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <TextView
        android:id="@+id/tvBabyEmoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/baby_home_waiting_emoji"
        android:textSize="72sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvWaitingMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvWaitingMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/baby_home_waiting_message"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvBabyEmoji"
        app:layout_constraintBottom_toTopOf="@id/appGrid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Icons for apps the caregiver registered in the app picker; empty
         (zero-height) when none are registered. -->
    <GridLayout
        android:id="@+id/appGrid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:columnCount="3"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvWaitingMessage"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Hidden caregiver-only exit: hold for 3 seconds, then enter the family
        PIN. Sized generously and kept clear of the very edge/corner (24dp
        margin) so it doesn't compete with the system's own edge-swipe
        gesture-navigation zone, which can otherwise swallow touches placed
        right at the screen edge before this view ever sees them.
    -->
    <View
        android:id="@+id/hiddenExitDot"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="#11000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
